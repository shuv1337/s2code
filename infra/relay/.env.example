# Required: Fork-owned Cloudflare account
# alchemy.run.ts pins Cloudflare state to CLOUDFLARE_ACCOUNT_ID (32-char hex)
# and rejects upstream domains as well as RFC 2606 placeholders (example.com,
# .example, .invalid, .test).
CLOUDFLARE_ACCOUNT_ID=

# Required: Relay API and managed tunnel domains (fork-owned Cloudflare zones)
# Production adopts retained DNS zones in your Cloudflare account. The API
# zone serves relay.<zone> in production and relay-<stage>.<zone> for personal
# stages. Managed environment endpoints are provisioned below the tunnel zone.
# Both may point at the same zone.
RELAY_API_ZONE_NAME=
RELAY_TUNNEL_ZONE_NAME=

# Database backend (required: configure EITHER external Postgres OR PlanetScale).
# External Postgres mode is selected whenever RELAY_DB_HOST is set (prod stage only).
# When both RELAY_DB_ACCESS_CLIENT_ID and RELAY_DB_ACCESS_CLIENT_SECRET are set,
# Hyperdrive uses Cloudflare Access + Tunnel (AccessOrigin); otherwise PublicOrigin.
RELAY_DB_HOST=
# RELAY_DB_PORT=5432
RELAY_DB_NAME=
RELAY_DB_USER=
RELAY_DB_PASSWORD=
# RELAY_DB_ACCESS_CLIENT_ID=
# RELAY_DB_ACCESS_CLIENT_SECRET=
# RELAY_DB_CONNECTION_LIMIT=20
# RELAY_DB_MIGRATION_SSLMODE=require

# Alternative: PlanetScale Postgres mode (used when RELAY_DB_HOST is unset).
# Defaults avoid upstream's PS_160/2-replica cluster.
# PLANETSCALE_ORGANIZATION=
# PLANETSCALE_API_TOKEN_ID=
# PLANETSCALE_API_TOKEN=
# RELAY_DB_CLUSTER_SIZE=PS_5
# RELAY_DB_REPLICAS=0

# Optional: Observability
# Leave AXIOM_TOKEN unset to run with no Axiom resources, no R2 source-map bucket,
# and no mobile telemetry forwarding. Optionally export Worker spans to a
# self-hosted OTLP/HTTP endpoint instead:
# RELAY_OTLP_TRACES_URL=
# RELAY_OTLP_TRACES_TOKEN=
#
# Or enable upstream Axiom observability by setting both:
# AXIOM_ORG_ID=
# AXIOM_TOKEN=

# Optional: inactive tunnel cleanup. Start with dry-run, verify the cleanup
# logs, then set enabled. Unset and off both disable cleanup.
# RELAY_TUNNEL_CLEANUP_MODE=off
# Optional: cleanup for tunnels whose host never registered recovery, once they
# have been down for 30 days. Same values, independent of the mode above.
# RELAY_LEGACY_TUNNEL_CLEANUP_MODE=off
# Canary stages only: shorten the 30-day legacy grace period, in minutes.
# Ignored on prod.
# RELAY_LEGACY_TUNNEL_GRACE_MINUTES=10

# Optional: relay monitors and health dashboard in Axiom (requires AXIOM_TOKEN).
# RELAY_ALERT_NOTIFIER_ID=
# RELAY_WARNING_NOTIFIER_ID=

# Optional: Relay domain override
# Set this only when the derived relay hostname should not be used.
# RELAY_DOMAIN=

# Required: Clerk (fork-owned instance)
# Get the keys from the Clerk Dashboard under API keys. Set the JWT audience to
# the `aud` claim configured on the `t3-relay` JWT template.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_AUDIENCE=t3-code-relay

# Apple Push Notification service (disabled by default in this fork).
# Set APNS_ENABLED=true and populate APNS_* only when enabling iOS push.
APNS_ENABLED=false
# APNS_ENVIRONMENT=sandbox
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_BUNDLE_ID=
# APNS_PRIVATE_KEY=

# Optional: Android push. Set this secret to the service account JSON from
# Firebase Project settings > Service accounts. Never put it in an app build.
# FCM_SERVICE_ACCOUNT={...}
