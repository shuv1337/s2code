# Maintained in https://github.com/shuv1337/shuv2code/tree/main/packaging/aur

pkgname=s2code-nightly-bin
pkgver=0.0.0_nightly.19700101.0
pkgrel=1
pkgdesc='Nightly desktop control surface for local coding agents'
arch=('x86_64')
url='https://github.com/shuv1337/shuv2code'
license=('MIT')
provides=('shuv2code-nightly-bin')
conflicts=('shuv2code-nightly-bin')
replaces=('shuv2code-nightly-bin')
depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'dbus'
  'expat'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libcups'
  'libdrm'
  'libgcc'
  'libstdc++'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'systemd-libs'
  'xdg-utils'
  'zlib'
)
optdepends=('openai-codex: use the system-installed Codex CLI')
options=('!debug' '!strip')

_release_version="${pkgver/_nightly./-nightly.}"
_appimage="S2Code-${_release_version}-x86_64.AppImage"
source=(
  "$_appimage::https://github.com/shuv1337/shuv2code/releases/download/v${_release_version}/$_appimage"
  "${pkgname}-${pkgver}-LICENSE::https://raw.githubusercontent.com/shuv1337/shuv2code/v${_release_version}/LICENSE"
)
sha256sums=(
  # The publisher replaces these placeholders with verified fork release digests.
  'UNRELEASED' # AppImage
  'UNRELEASED' # release license
)

prepare() {
  chmod +x "$srcdir/$_appimage"
  rm -rf "$srcdir/squashfs-root"
  "$srcdir/$_appimage" --appimage-extract >/dev/null

  if [[ ! -x "$srcdir/squashfs-root/AppRun" ||
        ! -f "$srcdir/squashfs-root/chrome-sandbox" ]]; then
    echo 'The AppImage payload is missing its launcher or Chromium sandbox.' >&2
    return 1
  fi
}

package() {
  install -d "$pkgdir/opt/$pkgname"
  cp -a --no-preserve=ownership "$srcdir/squashfs-root/." "$pkgdir/opt/$pkgname/"
  chmod -R u=rwX,go=rX "$pkgdir/opt/$pkgname"
  chmod 4755 "$pkgdir/opt/$pkgname/chrome-sandbox"

  install -Dm755 /dev/stdin "$pkgdir/usr/bin/s2code-nightly" <<'EOF'
#!/bin/sh
exec /opt/s2code-nightly-bin/AppRun "$@"
EOF
  ln -s s2code-nightly "$pkgdir/usr/bin/shuv2code-nightly"

  # Icon lookup only sees sizes registered in hicolor's index.theme (max 512x512).
  local icon size_dir
  for icon in "$srcdir"/squashfs-root/usr/share/icons/hicolor/*/apps/s2code-nightly.png; do
    size_dir="${icon%/apps/s2code-nightly.png}"
    install -Dm644 "$icon" \
      "$pkgdir/usr/share/icons/hicolor/${size_dir##*/}/apps/s2code-nightly.png"
  done

  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/s2code-nightly.desktop" <<'EOF'
[Desktop Entry]
Name=S2Code (Nightly)
Comment=Nightly desktop control surface for local coding agents
Exec=s2code-nightly %U
TryExec=s2code-nightly
Terminal=false
Type=Application
Icon=s2code-nightly
StartupWMClass=s2code-nightly
Categories=Development;
MimeType=x-scheme-handler/s2code-nightly;x-scheme-handler/shuv2code-nightly;
EOF

  install -Dm644 "$srcdir/${pkgname}-${pkgver}-LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
