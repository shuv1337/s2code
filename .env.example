# Optional: Fork Connect source builds
# Copy to `.env` and fill in your fork-owned deployment values to enable Connect.
# These are public build identifiers, not secrets. Leave commented out or unset
# for a cloudless build (direct and Tailscale pairing remain available).
# Upstream domains and Clerk keys are rejected. Do not add server-side secrets here.

# Fork Clerk instance (Clerk Dashboard -> API keys, JWT templates, OAuth applications).
# T3CODE_CLERK_PUBLISHABLE_KEY=pk_live_...
# T3CODE_CLERK_JWT_TEMPLATE=t3-relay
# T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=...

# Fork relay URL and pinned Ed25519 credential-minting public key (single-line
# \n-escaped PEM). Local `infra/relay` deploys update both automatically, and
# `deploy-relay.yml` prints them in its workflow summary.
# T3CODE_RELAY_URL=https://relay.<your-domain>
# T3CODE_CLOUD_MINT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Optional: hosted web app origin for browser-based CLI OAuth (`/connect`).
# Omit when no hosted web app is deployed; the CLI automatically uses Clerk's
# device-authorization flow instead.
# T3CODE_HOSTED_APP_URL=https://app.<your-domain>

# Optional: signed macOS passkey builds. Signed macOS builds only enable
# Associated Domains passkeys when T3CODE_MACOS_PROVISIONING_PROFILE or
# T3CODE_CLERK_PASSKEY_RP_DOMAINS is set.
# T3CODE_APPLE_TEAM_ID=ABC1234567
# T3CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/s2code.provisionprofile
# T3CODE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.<your-domain>

# Optional: public, ingest-only mobile OpenTelemetry configuration.
# T3CODE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# T3CODE_MOBILE_OTLP_TRACES_DATASET=t3-code-mobile-traces-dev
# T3CODE_MOBILE_OTLP_TRACES_TOKEN=xaat-...
