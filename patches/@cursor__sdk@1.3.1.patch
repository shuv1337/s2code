+"use strict";
+
+const diagnostics = require("node:diagnostics_channel").channel("s2code.cursor.retry");
+const checkpointMessage = "Cursor could not confirm that this answer was saved. Automatic replay was stopped; the next message will recover in a fresh Cursor session.";
+
+exports.guard = function guard(input) {
+  let turnEnded = false;
+  let checkpoint = "none";
+  const sendUpdate = input.interaction.sendUpdate;
+  input.interaction.sendUpdate = function (context, update) {
+    if (update.message?.case === "turnEnded") turnEnded = true;
+    return sendUpdate.call(this, context, update);
+  };
+
+  return {
+    ...input,
+    hooks: {
+      ...input.hooks,
+      runAttempt(attempt) {
+        checkpoint = "none";
+        const handler = attempt.checkpointHandler;
+        return input.hooks.runAttempt({
+          ...attempt,
+          checkpointHandler: {
+            ...handler,
+            async handleCheckpoint(...args) {
+              await handler.handleCheckpoint(...args);
+              checkpoint = args[2]?.resumeEligibility ?? "eligible";
+            },
+          },
+        });
+      },
+      classify(cause, info) {
+        let decision = input.hooks.classify(cause, info);
+        const cancelled = decision.action === "throw" && decision.error.kind === "CancelledError";
+        const blocked = turnEnded && checkpoint !== "ineligible_terminal_turn" && !cancelled;
+        if (blocked) {
+          decision = {
+            action: "throw",
+            error: input.checkpointError(cause, info.attemptRequestId, checkpointMessage),
+          };
+        }
+        diagnostics.publish({
+          requestId: info.attemptRequestId,
+          originalRequestId: info.originalRequestId,
+          attempt: info.attempt,
+          decision: blocked ? "blocked_after_turn_ended" : decision.action === "retry" && checkpoint === "ineligible_terminal_turn" ? "completed_from_checkpoint" : decision.action,
+          turnEnded,
+          checkpoint,
+          cause,
+        });
+        return decision;
+      },
+    },
+  };
+};
